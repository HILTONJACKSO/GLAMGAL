# GLAMGAL Storefront API Environment Configuration

# Shopify Store Domain (e.g. glamgal-beauty.myshopify.com)
VITE_PUBLIC_STORE_DOMAIN=glamgal-beauty.myshopify.com

# Shopify Storefront API Access Token
VITE_PUBLIC_STOREFRONT_API_TOKEN=your_storefront_access_token_here

# Shopify API Version
VITE_PUBLIC_STORE_VERSION=2024-01

# Toggle live Shopify API vs local CMS mock catalog (true/false)
VITE_USE_MOCK_SHOPIFY=true
